########################################
# NovaOS - .gitignore
########################################

# ---- Build artifacts ----
build/
iso/
*.o
*.elf
*.bin
*.iso
*.img
*.map
*.sym
*.d

# ---- Toolchain / cross-compiler (built locally by setup scripts) ----
toolchain/
cross/
opt/

# ---- Rust sysroot (Phase 33) - large (40MB+), fully regenerated by
# tools/rust-sysroot/build-sysroot.sh on demand, never hand-edited ----
tools/rust-sysroot/sysroot/

# ---- Rust custom target JSON (Phase 35 fix) - regenerated on every
# run. Several of its fields' correct JSON *type* (string vs number)
# genuinely differs between rustc versions - confirmed by real
# machines needing different fields flipped - so it's detected per-
# build, not something that can be committed as one fixed,
# correct-for-everyone file ----
tools/rust-sysroot/i686-novaos.json

# ---- Fallback-path artifacts (build-sysroot-bootstrap.sh): fetched
# compiler_builtins source (patched in place) and its probe scratch
# file. Regenerated on demand, never hand-edited ----
tools/rust-sysroot/compiler_builtins-*-src/
tools/rust-sysroot/rust_target_probe.rs

# ---- Preferred-path artifact (build-sysroot.sh): the throwaway cargo
# project used only to trigger `-Z build-std`. Nothing in this project
# links against it; it exists solely as a build scratch space ----
tools/rust-sysroot/nightly-build-std-project/

# ---- Logs & test output ----
*.log
serial.log
qemu.log
test-results/

# ---- JetBrains / IntelliJ / CLion (do not commit) ----
.idea/
*.iml
*.ipr
*.iws
cmake-build-*/

# ---- VS Code ----
.vscode/
*.code-workspace

# ---- Visual Studio ----
.vs/
*.vcxproj*
*.sln

# ---- Vim / Emacs swap files ----
*.swp
*.swo
*~
\#*\#
.#*

# ---- macOS ----
.DS_Store
.AppleDouble
.LSOverride

# ---- Windows ----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- Linux ----
*~

# ---- Editors / language servers ----
.clangd/
compile_commands.json
.ccls-cache/

# ---- Env / secrets (never commit) ----
.env
*.pem
*.key

# ---- Debug/session artifacts ----
.gdb_history
*.gdbinit.local
